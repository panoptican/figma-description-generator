{
  "name": "description-generator",
  "version": "1.0.0",
  "description": "Generate descriptions for Figma components and component sets.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <26.0.0"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@create-figma-plugin/ui": "^3.2.0",
    "@create-figma-plugin/utilities": "^3.2.0",
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^3.2.0",
    "@figma/plugin-typings": "^1.98.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "figma-plugin": {
    "documentAccess": "dynamic-page",
    "editorType": [
      "figma"
    ],
    "id": "description-generator",
    "name": "Description Generator",
    "networkAccess": {
      "allowedDomains": [
        "https://api.openai.com",
        "https://api.anthropic.com",
        "https://generativelanguage.googleapis.com"
      ]
    },
    "menu": [
      {
        "name": "This page",
        "main": {
          "src": "src/main.ts",
          "handler": "currentPage"
        },
        "ui": "src/ui.tsx"
      },
      {
        "name": "Entire file",
        "main": {
          "src": "src/main.ts",
          "handler": "allPages"
        },
        "ui": "src/ui.tsx"
      }
    ]
  }
}
